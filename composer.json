{
	"name": "prc/quiz-builder",
	"description": "Quiz builder plugin for the PRC platform (interactive quizzes with group sharing).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"automattic/jetpack-autoloader": "^5.0",
		"kreait/firebase-php": "^7.0",
		"prc/block-utils": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"automattic/jetpack-autoloader": true,
			"php-http/discovery": true
		},
		"github-protocols": [
			"https"
		],
		"platform": {
			"php": "8.4.0"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/pewresearch/prc-block-utils"
		}
	]
}
